# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
wheels/
pip-log.txt
pip-delete-this-directory.txt

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ============================================================
# Virtual environments
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
# Environment / secrets
# ============================================================
.env
.env.local
.envrc
*.pem
*.key
secrets/

# ============================================================
# Data — too large for git, regenerate from scripts
# ============================================================
data/*
!data/.gitkeep

# ============================================================
# Results — keep summary CSVs + final figures, drop raw dumps
# ============================================================
results/**/*.npz
results/**/*.npy
results/**/*.pkl
results/**/*.h5
results/**/*.hdf5
results/**/*.pt
results/**/*.pth
results/**/raw/
results/**/checkpoints/

